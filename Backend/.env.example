# Copy this file to .env and fill in real values.

PORT=3000

# PostgreSQL connection (see Backend/db.js)
DB_USER=
DB_HOST=localhost
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Secret used to sign/verify JWTs (Backend/middleware/auth.js). Use a long,
# random value — do not reuse the value from any other environment.
JWT_SECRET=
